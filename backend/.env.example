# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL(s) allowed to call this API (comma-separated).
# In production, set this to your deployed frontend, e.g.
# FRONTEND_URL=https://radar-ai.vercel.app
FRONTEND_URL=http://localhost:3000

# ─── AI provider (all optional) ──────────────────────────────────────────────
# Without any key the app runs in rule-based mode (fully working, no AI text).
# Every key you set joins a fallback chain in this order — if one provider is
# rate-limited or down, the next one answers:
#
#   Groq (free tier, fast):   https://console.groq.com/keys
GROQ_API_KEY=
#   OpenRouter (free models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
#   Google Gemini:            https://aistudio.google.com/apikey
GEMINI_API_KEY=
#   OpenAI (paid):            https://platform.openai.com/api-keys
OPENAI_API_KEY=
#
# Advanced — use ONE specific provider instead of the chain:
# AI_PROVIDER=groq            # groq | openrouter | gemini | openai | ollama | custom | none
# AI_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant   # models to rotate through
# AI_BASE_URL=                # any OpenAI-compatible endpoint (required for custom)
# AI_API_KEY=                 # key for AI_PROVIDER

# ─── GitHub (optional) ──────────────────────────────────────────────────────
# Not required: public repo code is downloaded without a token.
# A token only raises the limit for repo info/commits (60 → 5,000 req/hour).
# Create a fine-grained token with "Public repositories (read-only)" access:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# ─── Test runners (optional) ─────────────────────────────────────────────────
# SELENIUM_ENABLED=true          # set false to skip browser tests
# SELENIUM_MAX_CONCURRENCY=1     # headless Chrome instances allowed at once
# CHROME_BIN=/usr/bin/chromium   # set automatically in the Docker image
# CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Multi-page crawl limits
# CRAWL_MAX_PAGES=20              # public pages per run
# CRAWL_MAX_LOGGED_IN_PAGES=15    # pages behind the login (needs a test account)

# Security scanning is built in (SSL/TLS, headers, cookies, CORS, mixed content,
# open redirects…) and needs no configuration.

# ─── Safety limits (optional) ────────────────────────────────────────────────
# ALLOW_PRIVATE_URLS=false       # true lets you test localhost sites (local dev only!)
# RATE_LIMIT_GENERAL=600         # API requests per IP per 15 min
# RATE_LIMIT_HEAVY=40            # analysis runs per IP per 10 min
# SESSION_TTL_HOURS=24           # idle user sessions are cleared after this
